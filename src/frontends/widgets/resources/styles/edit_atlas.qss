QMainWindow {
  background-color: @window@;
}

QLabel#subtitleLabel, QLabel#emptyDescriptionLabel, QLabel#privacyLabel,
QLabel#filterResultLabel {
  color: @textSecondary@;
}

QLabel#templateStatusLabel {
  color: @warning@;
}

QLabel#filterSectionTitle {
  font-weight: @headingWeight@;
}

QFrame#templatePanel {
  background-color: @surfaceAlternate@;
  border: 1px solid @border@;
  border-radius: 8px;
}

QFrame#filterPanel {
  background-color: @surface@;
  border: 1px solid @border@;
  border-radius: 8px;
}

QFrame#filterDivider {
  background-color: @border@;
  border: 0;
  max-height: 1px;
}

QFrame#resultsHeader {
  border: 0;
  border-bottom: 1px solid @border@;
}

QWidget#filterConditionRow {
  background-color: @control@;
  border-radius: 6px;
}

QLabel#filterErrorLabel, QLabel#columnSelectionErrorLabel {
  color: @danger@;
}

QComboBox {
  background-color: @control@;
  border: 1px solid @border@;
  border-radius: 6px;
  min-height: 24px;
  padding: 3px 28px 3px 9px;
}

QComboBox:hover {
  border-color: @accent@;
}

QComboBox::drop-down {
  border: 0;
  width: 24px;
}

QLineEdit, QPushButton, QToolButton {
  background-color: @control@;
  border: 1px solid @border@;
  border-radius: 6px;
  min-height: 28px;
  padding: 3px 9px;
}

QLineEdit:focus {
  border-color: @focus@;
}

QPushButton:hover, QToolButton:hover, QToolButton:checked {
  border-color: @accent@;
}

QPushButton:pressed, QToolButton:pressed {
  background-color: @controlPressed@;
}

QComboBox:disabled, QLineEdit:disabled, QPushButton:disabled,
QToolButton:disabled {
  background-color: @controlPressed@;
  border-color: @controlPressed@;
  color: @disabled@;
}

QListWidget, QTableView, QTreeWidget {
  border: 1px solid @border@;
  border-radius: 6px;
  gridline-color: @border@;
  selection-background-color: @accent@;
}

QHeaderView::section {
  background-color: @control@;
  border: 0;
  border-bottom: 1px solid @border@;
  padding: 6px 8px;
}

QGroupBox {
  border: 1px solid @border@;
  border-radius: 6px;
  margin-top: 8px;
  padding-top: 8px;
}

QGroupBox::title {
  left: 8px;
  padding: 0 4px;
}

QProgressBar {
  background-color: @control@;
  border: 1px solid @border@;
  border-radius: 4px;
  max-height: 8px;
}

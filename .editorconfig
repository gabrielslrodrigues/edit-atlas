# EditorConfig helps maintain consistent text formatting across editors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cmake,txt,qml,py}]
indent_size = 4

[*.{cpp,hpp,json,yaml,yml,sh,ps1,psd1,qss,md}]
indent_size = 2

[*.py]
max_line_length = 79

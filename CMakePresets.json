{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg-overlays",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/vcpkg-triplets"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "x64-linux",
      "hidden": true,
      "inherits": "linux",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "osx",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "arm64-osx",
      "hidden": true,
      "inherits": "osx",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "x64-osx",
      "hidden": true,
      "inherits": "osx",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-osx"
      }
    },
    {
      "name": "universal-osx",
      "hidden": true,
      "inherits": "osx",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64;arm64",
        "VCPKG_TARGET_TRIPLET": "universal-osx"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "x64-windows",
      "hidden": true,
      "inherits": "windows",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "debug-x64-linux",
      "inherits": [
        "x64-linux",
        "debug"
      ],
      "displayName": "Debug - Linux x64",
      "description": "Configure a Linux x64 debug build"
    },
    {
      "name": "release-x64-linux",
      "inherits": [
        "x64-linux",
        "release"
      ],
      "displayName": "Release - Linux x64",
      "description": "Configure a Linux x64 release build"
    },
    {
      "name": "debug-arm64-osx",
      "inherits": [
        "arm64-osx",
        "debug"
      ],
      "displayName": "Debug - macOS ARM64",
      "description": "Configure a macOS ARM64 debug build"
    },
    {
      "name": "release-arm64-osx",
      "inherits": [
        "arm64-osx",
        "release"
      ],
      "displayName": "Release - macOS ARM64",
      "description": "Configure a macOS ARM64 release build"
    },
    {
      "name": "debug-x64-osx",
      "inherits": [
        "x64-osx",
        "debug"
      ],
      "displayName": "Debug - macOS x64",
      "description": "Configure a macOS x64 debug build"
    },
    {
      "name": "release-x64-osx",
      "inherits": [
        "x64-osx",
        "release"
      ],
      "displayName": "Release - macOS x64",
      "description": "Configure a macOS x64 release build"
    },
    {
      "name": "debug-universal-osx",
      "inherits": [
        "universal-osx",
        "debug"
      ],
      "displayName": "Debug - macOS Universal",
      "description": "Configure a universal macOS x86_64 and ARM64 debug build"
    },
    {
      "name": "release-universal-osx",
      "inherits": [
        "universal-osx",
        "release"
      ],
      "displayName": "Release - macOS Universal",
      "description": "Configure a universal macOS x86_64 and ARM64 release build"
    },
    {
      "name": "debug-x64-windows",
      "inherits": [
        "x64-windows",
        "debug"
      ],
      "displayName": "Debug - Windows x64",
      "description": "Configure a Windows x64 debug build"
    },
    {
      "name": "release-x64-windows",
      "inherits": [
        "x64-windows",
        "release"
      ],
      "displayName": "Release - Windows x64",
      "description": "Configure a Windows x64 release build"
    }
  ],
  "buildPresets": [
    {
      "name": "debug-x64-linux",
      "configurePreset": "debug-x64-linux"
    },
    {
      "name": "release-x64-linux",
      "configurePreset": "release-x64-linux"
    },
    {
      "name": "debug-arm64-osx",
      "configurePreset": "debug-arm64-osx"
    },
    {
      "name": "release-arm64-osx",
      "configurePreset": "release-arm64-osx"
    },
    {
      "name": "debug-x64-osx",
      "configurePreset": "debug-x64-osx"
    },
    {
      "name": "release-x64-osx",
      "configurePreset": "release-x64-osx"
    },
    {
      "name": "debug-universal-osx",
      "configurePreset": "debug-universal-osx"
    },
    {
      "name": "release-universal-osx",
      "configurePreset": "release-universal-osx"
    },
    {
      "name": "debug-x64-windows",
      "configurePreset": "debug-x64-windows"
    },
    {
      "name": "release-x64-windows",
      "configurePreset": "release-x64-windows"
    }
  ],
  "testPresets": [
    {
      "name": "debug-x64-linux",
      "configurePreset": "debug-x64-linux",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release-x64-linux",
      "configurePreset": "release-x64-linux",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug-arm64-osx",
      "configurePreset": "debug-arm64-osx",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release-arm64-osx",
      "configurePreset": "release-arm64-osx",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug-x64-osx",
      "configurePreset": "debug-x64-osx",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release-x64-osx",
      "configurePreset": "release-x64-osx",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug-universal-osx",
      "configurePreset": "debug-universal-osx",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release-universal-osx",
      "configurePreset": "release-universal-osx",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug-x64-windows",
      "configurePreset": "debug-x64-windows",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release-x64-windows",
      "configurePreset": "release-x64-windows",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "packagePresets": [
    {
      "name": "package-release-x64-linux",
      "displayName": "Package Release - Linux x64",
      "configurePreset": "release-x64-linux",
      "generators": [
        "TGZ",
        "DEB",
        "RPM"
      ],
      "packageDirectory": "${sourceDir}/build/packages/x64-linux",
      "output": {
        "verbose": true
      }
    },
    {
      "name": "package-release-universal-osx",
      "displayName": "Package Release - macOS Universal",
      "configurePreset": "release-universal-osx",
      "generators": [
        "productbuild"
      ],
      "packageDirectory": "${sourceDir}/build/packages/universal-osx",
      "output": {
        "verbose": true
      }
    },
    {
      "name": "package-release-x64-windows",
      "displayName": "Package Release - Windows x64",
      "configurePreset": "release-x64-windows",
      "generators": [
        "WIX"
      ],
      "packageDirectory": "${sourceDir}/build/packages/x64-windows",
      "output": {
        "verbose": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "create-package-x64-linux",
      "displayName": "Create Package - Linux x64",
      "steps": [
        {
          "type": "configure",
          "name": "release-x64-linux"
        },
        {
          "type": "build",
          "name": "release-x64-linux"
        },
        {
          "type": "package",
          "name": "package-release-x64-linux"
        }
      ]
    },
    {
      "name": "create-package-universal-osx",
      "displayName": "Create Package - macOS Universal",
      "steps": [
        {
          "type": "configure",
          "name": "release-universal-osx"
        },
        {
          "type": "build",
          "name": "release-universal-osx"
        },
        {
          "type": "package",
          "name": "package-release-universal-osx"
        }
      ]
    },
    {
      "name": "create-package-x64-windows",
      "displayName": "Create Package - Windows x64",
      "steps": [
        {
          "type": "configure",
          "name": "release-x64-windows"
        },
        {
          "type": "build",
          "name": "release-x64-windows"
        },
        {
          "type": "package",
          "name": "package-release-x64-windows"
        }
      ]
    }
  ]
}

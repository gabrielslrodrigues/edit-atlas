{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg-overlays",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/vcpkg-triplets"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "EDIT_ATLAS_BUILD_PACKAGING_APPLICATIONS": "ON"
      }
    },
    {
      "name": "primary-frontend",
      "hidden": true,
      "cacheVariables": {
        "EDIT_ATLAS_DEFAULT_FRONTEND": "quick"
      }
    },
    {
      "name": "widgets-frontend",
      "hidden": true,
      "cacheVariables": {
        "EDIT_ATLAS_BUILD_FRONTENDS": "widgets",
        "EDIT_ATLAS_DEFAULT_FRONTEND": "widgets"
      }
    },
    {
      "name": "quick-frontend",
      "hidden": true,
      "cacheVariables": {
        "EDIT_ATLAS_BUILD_FRONTENDS": "quick",
        "EDIT_ATLAS_DEFAULT_FRONTEND": "quick"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "x64-linux",
      "hidden": true,
      "inherits": "linux",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "osx",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "arm64-osx",
      "hidden": true,
      "inherits": "osx",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "x64-osx",
      "hidden": true,
      "inherits": "osx",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-osx"
      }
    },
    {
      "name": "universal-osx",
      "hidden": true,
      "inherits": "osx",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64;arm64",
        "VCPKG_TARGET_TRIPLET": "universal-osx"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "x64-windows",
      "hidden": true,
      "inherits": "windows",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "documentation",
      "displayName": "API documentation",
      "description": "Configure the standalone public API documentation",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/documentation",
      "cacheVariables": {
        "EDIT_ATLAS_BUILD_DOCUMENTATION": "ON",
        "EDIT_ATLAS_DOCUMENTATION_ONLY": "ON"
      }
    },
    {
      "name": "debug-x64-linux",
      "inherits": [
        "x64-linux",
        "debug",
        "primary-frontend"
      ],
      "displayName": "Debug - Linux x64",
      "description": "Configure a Linux x64 debug build"
    },

file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/MinimumVersion.txt"
    EDIT_ATLAS_MINIMUM_CMAKE_VERSION)
cmake_minimum_required(VERSION ${EDIT_ATLAS_MINIMUM_CMAKE_VERSION})

# Intermediate cleanup retains installed tools, including NuGet. Source
# archives and build staging are disposable; tools are needed by Release.
if(NOT DEFINED EDIT_ATLAS_VCPKG_ROOT
   OR NOT IS_DIRECTORY "${EDIT_ATLAS_VCPKG_ROOT}/scripts")
    message(FATAL_ERROR "EDIT_ATLAS_VCPKG_ROOT must name a vcpkg checkout")
endif()
file(REAL_PATH "${EDIT_ATLAS_VCPKG_ROOT}" root)

function(report_usage phase)
    foreach(name IN ITEMS buildtrees downloads packages)
        file(GLOB_RECURSE entries LIST_DIRECTORIES FALSE "${root}/${name}/*")
        set(bytes 0)
        foreach(entry IN LISTS entries)
            if(NOT IS_SYMLINK "${entry}")
                file(SIZE "${entry}" size)
                math(EXPR bytes "${bytes} + ${size}")
            endif()
        endforeach()
        set(line "${phase}: vcpkg/${name}: ${bytes} bytes")
        message(STATUS "${line}")
        if(DEFINED ENV{GITHUB_STEP_SUMMARY})
            file(APPEND "$ENV{GITHUB_STEP_SUMMARY}" "- ${line}\n")
        endif()
    endforeach()
endfunction()

report_usage("Before cleanup")
if(DEFINED EDIT_ATLAS_DIAGNOSTICS_DIR)
    file(GLOB_RECURSE logs LIST_DIRECTORIES FALSE "${root}/buildtrees/*.log")
    foreach(log IN LISTS logs)
        file(RELATIVE_PATH relative "${root}/buildtrees" "${log}")
        get_filename_component(directory "${relative}" DIRECTORY)
        file(MAKE_DIRECTORY "${EDIT_ATLAS_DIAGNOSTICS_DIR}/${directory}")
        file(COPY "${log}" DESTINATION
            "${EDIT_ATLAS_DIAGNOSTICS_DIR}/${directory}")
    endforeach()
endif()
file(REMOVE_RECURSE "${root}/buildtrees" "${root}/packages")
if(EDIT_ATLAS_FINAL_CLEANUP)
    file(REMOVE_RECURSE "${root}/downloads")
else()
    file(GLOB entries "${root}/downloads/*")
    foreach(entry IN LISTS entries)
        if(NOT entry STREQUAL "${root}/downloads/tools")
            file(REMOVE_RECURSE "${entry}")
        endif()
    endforeach()
endif()
report_usage("After cleanup")

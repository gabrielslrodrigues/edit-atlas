{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "edit-atlas",
  "version-string": "0.1.0",
  "description": "Inspect editorial timelines and export structured reports",
  "license": "Apache-2.0",
  "builtin-baseline": "40f3c709db80acf154ac4b17a1f83c564ebd022e",
  "dependencies": [
    "gtest",
    "libxlsxwriter",
    "minizip",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "widgets"
      ]
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "fontconfig",
        "wayland",
        "xcb"
      ],
      "platform": "linux"
    },
    {
      "name": "qttools",
      "default-features": false
    },
    "spdlog"
  ]
}

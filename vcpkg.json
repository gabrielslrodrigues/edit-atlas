{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "edit-atlas",
  "version-string": "0.2.0",
  "description": "Inspect editorial timelines and export structured reports",
  "license": "Apache-2.0",
  "builtin-baseline": "40f3c709db80acf154ac4b17a1f83c564ebd022e",
  "dependencies": [
    {
      "name": "at-spi2-core",
      "default-features": false,
      "platform": "linux"
    },
    "cli11",
    {
      "name": "dbus",
      "default-features": false,
      "platform": "linux"
    },
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swscale"
      ]
    },
    "gtest",
    "libpng",
    "libxlsxwriter",
    "minizip",
    "nlohmann-json",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "concurrent",
        "dnslookup",
        "testlib",
        "widgets"
      ]
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "dbus",
        "fontconfig",
        "wayland",
        "xcb"
      ],
      "platform": "linux"
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "windeployqt"
      ],
      "platform": "windows"
    },
    {
      "name": "qttools",
      "default-features": false
    },
    "re2",
    "spdlog"
  ]
}
